#!/usr/bin/env ruby
# frozen_string_literal: true

# Build y.S with the buffer size that benchmarks fastest on this machine.
#
# Usage: ycc [-o out] file.S
#
# Environment:
#   YCC_SIZES  buffer sizes to try, multiples of 4096
#   YCC_BYTES  bytes piped per run
#   YCC_RUNS   runs per size
#   CC         compiler driver

require 'etc'
require 'optparse'
require 'shellwords'
require 'tmpdir'

def usage
  warn 'usage: ycc [-o out] file.S'
  exit 2
end

def require_target
  os, arch = Etc.uname.values_at(:sysname, :machine)
  return if os == 'Darwin' && arch == 'arm64'

  warn "ycc: unsupported target #{os}/#{arch} (need Darwin/arm64)"
  exit 1
end

# Returns the output path and the source path.
def parse_args(argv)
  out = 'a.out'
  args = OptionParser.new { |opts| opts.on('-o OUT') { |value| out = value } }.parse(argv)
  usage unless args.size == 1

  [out, args.first]
rescue OptionParser::ParseError
  usage
end

# Buffer sizes to try.
def candidates
  ENV.fetch('YCC_SIZES', '8192 16384 32768 65536 131072 262144 1048576').split.map(&:to_i)
end

def run(*command)
  system(*command) || exit($?.exitstatus || 1)
end

def build(size, out, src)
  run(ENV.fetch('CC', 'cc'), "-DBUFSZ=#{size}", '-o', out, src)

  out
end

# Returns binary paths by buffer size.
def build_all(sizes, dir, src)
  sizes.to_h { |size| [size, build(size, File.join(dir, size.to_s), src)] }
end

# Seconds taken to pipe +bytes+ bytes into head.
def measure(bin, bytes)
  start = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  run("#{bin.shellescape} | head -c #{bytes} > /dev/null")

  Process.clock_gettime(Process::CLOCK_MONOTONIC) - start
end

# Returns seconds by buffer size.
def benchmark(bins, bytes, runs)
  times = Hash.new(Float::INFINITY)
  runs.times do
    bins.each { |size, bin| times[size] = [times[size], measure(bin, bytes)].min }
  end

  times
end

def report(times, bytes)
  times.each do |size, seconds|
    warn format('ycc: BUFSZ=%-8d %.3fs  %.2f GB/s', size, seconds, bytes / seconds / 1e9)
  end
end

def fastest(times)
  times.min_by { |_size, seconds| seconds }.first
end

def main(argv)
  out, src = parse_args(argv)
  require_target
  bytes = ENV.fetch('YCC_BYTES', '4000000000').to_i
  runs = ENV.fetch('YCC_RUNS', '5').to_i

  Dir.mktmpdir('ycc') do |tmp|
    size = candidates
           .then { |sizes| build_all(sizes, tmp, src) }
           .then { |bins| benchmark(bins, bytes, runs) }
           .then { |times| report(times, bytes) }
           .then { |times| fastest(times) }

    warn "ycc: selected BUFSZ=#{size}"
    build(size, out, src)
  end
end

main(ARGV)
