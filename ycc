#!/usr/bin/env php
<?php
// ycc - build y.S with the buffer size that benchmarks fastest on this machine.

function usage(): never
{
    fwrite(STDERR, "usage: ycc [-o out] file.S\n");
    exit(2);
}

function run(string $command): void
{
    passthru($command, $status);
    if ($status !== 0) {
        exit($status);
    }
}

function build(int $size, string $out, string $src): void
{
    $cc = getenv('CC') ?: 'cc';
    run(sprintf('%s -DBUFSZ=%d -o %s %s', $cc, $size, escapeshellarg($out), escapeshellarg($src)));
}

$sizes = array_map('intval', preg_split('/\s+/', trim(getenv('YCC_SIZES') ?: '8192 16384 32768 65536 131072 262144 1048576')));
$bytes = (int) (getenv('YCC_BYTES') ?: 4000000000);
$runs = (int) (getenv('YCC_RUNS') ?: 5);

$opts = getopt('o:', [], $rest);
$args = array_slice($argv, $rest);
if ($opts === false || count($args) !== 1) {
    usage();
}
$out = $opts['o'] ?? 'a.out';
$src = $args[0];

$tmp = sys_get_temp_dir() . '/ycc.' . getmypid();
mkdir($tmp);
register_shutdown_function(function () use ($tmp) {
    array_map('unlink', glob("$tmp/*"));
    rmdir($tmp);
});

foreach ($sizes as $n) {
    build($n, "$tmp/$n", $src);
}

// Interleave the candidates so drift in machine load hits them equally,
// and keep each one's fastest run.
$best = array_fill_keys($sizes, INF);
for ($i = 0; $i < $runs; $i++) {
    foreach ($sizes as $n) {
        $start = hrtime(true);
        run(sprintf('%s | head -c %d > /dev/null', escapeshellarg("$tmp/$n"), $bytes));
        $best[$n] = min($best[$n], (hrtime(true) - $start) / 1e9);
    }
}

foreach ($best as $n => $t) {
    fprintf(STDERR, "ycc: BUFSZ=%-8d %.3fs  %.2f GB/s\n", $n, $t, $bytes / $t / 1e9);
}

$selected = array_search(min($best), $best);
fwrite(STDERR, "ycc: selected BUFSZ=$selected\n");
build($selected, $out, $src);
