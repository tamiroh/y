#!/usr/bin/env php
<?php

/**
 * Build y.S with the buffer size that benchmarks fastest on this machine.
 *
 * Usage: ycc [-o out] file.S
 *
 * Environment:
 *   YCC_SIZES  buffer sizes to try, multiples of 4096
 *   YCC_BYTES  bytes piped per run
 *   YCC_RUNS   runs per size
 *   CC         compiler driver
 */

function usage(): never
{
    fwrite(STDERR, "usage: ycc [-o out] file.S\n");
    exit(2);
}

function requireTarget(): void
{
    $os = PHP_OS_FAMILY;
    $arch = php_uname('m');
    if ($os !== 'Darwin' || $arch !== 'arm64') {
        fwrite(STDERR, "ycc: unsupported target $os/$arch (need Darwin/arm64)\n");
        exit(1);
    }
}

function env(string $name, string $default): string
{
    return getenv($name) ?: $default;
}

/** @return array{string, string} output path and source path */
function parseArgs(array $argv): array
{
    $opts = getopt('o:', [], $rest);
    $args = array_slice($argv, $rest);
    if ($opts === false || count($args) !== 1) {
        usage();
    }

    return [$opts['o'] ?? 'a.out', $args[0]];
}

/** @return int[] buffer sizes to try */
function candidates(): array
{
    return env('YCC_SIZES', '8192 16384 32768 65536 131072 262144 1048576')
        |> trim(...)
        |> (fn($sizes) => preg_split('/\s+/', $sizes))
        |> (fn($sizes) => array_map(intval(...), $sizes));
}

function tempDir(): string
{
    $dir = sys_get_temp_dir() . '/ycc.' . getmypid();
    mkdir($dir);
    register_shutdown_function(function () use ($dir) {
        array_map(unlink(...), glob("$dir/*"));
        rmdir($dir);
    });

    return $dir;
}

function run(string $command): void
{
    passthru($command, $status);
    if ($status !== 0) {
        exit($status);
    }
}

function build(int $size, string $out, string $src): string
{
    run(sprintf('%s -DBUFSZ=%d -o %s %s', env('CC', 'cc'), $size, escapeshellarg($out), escapeshellarg($src)));

    return $out;
}

/** @return array<int, string> binary path by buffer size */
function buildAll(array $sizes, string $dir, string $src): array
{
    return array_combine($sizes, array_map(fn($size) => build($size, "$dir/$size", $src), $sizes));
}

/** Seconds taken to pipe $bytes bytes into head. */
function measure(string $bin, int $bytes): float
{
    $start = hrtime(true);
    run(sprintf('%s | head -c %d > /dev/null', escapeshellarg($bin), $bytes));

    return (hrtime(true) - $start) / 1e9;
}

/** @return array<int, float> seconds by buffer size */
function benchmark(array $bins, int $bytes, int $runs): array
{
    $times = array_map(fn() => INF, $bins);
    for ($i = 0; $i < $runs; $i++) {
        foreach ($bins as $size => $bin) {
            $times[$size] = min($times[$size], measure($bin, $bytes));
        }
    }

    return $times;
}

function report(array $times, int $bytes): array
{
    foreach ($times as $size => $seconds) {
        fprintf(STDERR, "ycc: BUFSZ=%-8d %.3fs  %.2f GB/s\n", $size, $seconds, $bytes / $seconds / 1e9);
    }

    return $times;
}

function fastest(array $times): int
{
    return array_search(min($times), $times);
}

function main(array $argv): void
{
    [$out, $src] = parseArgs($argv);
    requireTarget();
    $bytes = (int) env('YCC_BYTES', '4000000000');
    $runs = (int) env('YCC_RUNS', '5');
    $tmp = tempDir();

    $size = candidates()
        |> (fn($sizes) => buildAll($sizes, $tmp, $src))
        |> (fn($bins) => benchmark($bins, $bytes, $runs))
        |> (fn($times) => report($times, $bytes))
        |> fastest(...);

    fwrite(STDERR, "ycc: selected BUFSZ=$size\n");
    build($size, $out, $src);
}

main($argv);
